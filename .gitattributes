vendor/** linguist-vendored
# Preserve indentation in upstream Metal shader sources verbatim.
vendor/gpui/** whitespace=-space-before-tab
# Match the bytes written by the ZPL template exporter on every platform.
*.tpl.zpl text eol=lf
# Template directories use byte offsets into the original printer commands.
*.tpl.tspl binary
*.tpl.epl binary
*.tpl.cpcl binary
*.tpl.dpl binary
crates/core/tests/fixtures/print-templates/* binary
